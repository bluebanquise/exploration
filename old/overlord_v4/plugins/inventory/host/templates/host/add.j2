{% extends "main.j2" %}

{% block content %}
<h1 class="title">Add host</h1>

<form id="add-host-form">
  <div class="field">
    <label class="label">Hostname</label>
    <div class="control">
      <input class="input" type="text" id="hostname" name="hostname" required>
    </div>
  </div>

  <div class="field">
    <label class="label">Alias</label>
    <div class="control">
      <input class="input" type="text" id="alias" name="alias">
    </div>
  </div>

  <div class="field">
    <div class="control">
      <button class="button is-primary" type="submit">Add host</button>
    </div>
  </div>
</form>

<script>
document.getElementById("add-host-form").addEventListener("submit", async (e) => {
  e.preventDefault();

  const hostname = document.getElementById("hostname").value.trim();
  const alias = document.getElementById("alias").value.trim();

  if (!hostname) {
    showNotification("is-danger", "Hostname is required");
    return;
  }

  const payload = {};
  payload[hostname] = {};
  if (alias) payload[hostname].alias = alias;

  try {
    await apiRequest("POST", "/api/v1/inventory/host", payload);
    window.location.href = "/inventory/host/list";
  } catch (e) {
    console.error("Failed to add host:", e);
  }
});
</script>
{% endblock %}
